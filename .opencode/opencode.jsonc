{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "z-ai-visual": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_MCP_KEY}",
        "Z_AI_MODE": "ZHIPU"
      }
    },
  "minimax-gen-image": {
    "type": "local",
    "command": ["npx", "-y", "minimax-mcp-tools"],
    "environment": {
      "MINIMAX_API_KEY": "{env:MINIMAX_MCP_KEY}"
    }
  }
  }
}
