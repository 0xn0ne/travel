# 拾途 (Shí Tú) Environment Configuration
# Copy to .env and fill in your API keys

# DeepSeek API (LLM for itinerary generation)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高德开放平台 API (POI search, route validation)
AMAP_API_KEY=

# OpenAI API (ChatGPT Group C competitor generation)
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/travel.db

# CORS
CORS_ORIGINS=["http://localhost:5173"]
