# 拾途 (Shí Tú) Environment Configuration
# Copy to .env and fill in your API keys

# LLM Provider API (DeepSeek / OpenAI-compatible)
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.deepseek.com
PROVIDER_MODEL=deepseek-chat

# 高德开放平台 API (POI search, route validation, weather)
AMAP_API_KEY=

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=

# Environment: development | production
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/travel.db

# CORS
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:5173"]

# OpenAI API (optional — only for Group C ChatGPT competitor testing)
OPENAI_API_KEY=
